model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["DataFolder","fact_transactions","fact_marketing_spend","dim_users","dim_plans","dim_date","dim_country","dim_channel","_Measures"]

ref table fact_transactions
ref table fact_marketing_spend
ref table dim_users
ref table dim_plans
ref table dim_date
ref table dim_country
ref table dim_channel
ref table dim_funnel_stage
ref table _Measures

ref cultureInfo en-US

